# Spotify Developer Dashboard — https://developer.spotify.com/dashboard
#
# Redirect URIs (exact match, with trailing slash):
#   https://vibe-flows.vercel.app/
#   http://localhost:5173/

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Same Client ID for browser PKCE login
VITE_SPOTIFY_CLIENT_ID=

# Neon Postgres (server-side only — never commit real credentials)
DATABASE_URL=

# Optional: prefer /api/catalog/* (Neon) then fall back to public/*.json
# Values: 1 | true — leave empty for JSON-only (default, PWA-safe)
VITE_USE_DB_CATALOG=

# Sentry (browser). Leave empty → SDK is a no-op.
VITE_SENTRY_DSN=
VITE_SENTRY_ENV=

# Optional: override creator Spotify link in Settings
# VITE_CREATOR_SPOTIFY_URL=

# Optional: Vercel team slug for npm run deploy:prod
# VERCEL_SCOPE=
